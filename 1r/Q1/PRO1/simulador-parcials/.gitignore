# Cache de los .cc descargados del repo fuente (smyha/smyha-FIB-UPC_PRO1):
# NO tiene licencia declarada, no se vendoriza nada de ahi en este repo.
.cache/

# Binarios compilados en make grade (quedan dentro de cada carpeta de intento).
intentos/*/*.bin

# Estado de la sesion interactiva (cronometro: start/end time). Es runtime,
# no forma parte del intento en si (el .cpp del usuario si se conserva).
intentos/*/.estado

    "respuestas" : {
      "P1" : "\/* ************************************************************************** *\/\n\/*                                                                            *\/\n\/*                                                        :::      ::::::::   *\/\n\/*   P60816.cpp                                         :+:      :+:    :+:   *\/\n\/*                                                    +:+ +:+         +:+     *\/\n\/*   By: agarcia2 <agarcia2@student.42barcelona.co  +#+  +:+       +#+        *\/\n\/*                                                +#+#+#+#+#+   +#+           *\/\n\/*   Created: 2026\/11\/19 09:05:26 by agarcia2          #+#    #+#             *\/\n\/*   Updated: 2026\/11\/19 09:05:26 by agarcia2         ###   ########.fr       *\/\n\/*                                                                            *\/\n\/* ************************************************************************** *\/\n\n#include <iostream>\n\nint\tmain(void)\n{\n\tint\tnbr;\n\n\tstd::cin >> nbr;\n\tif (nbr == 0)\n\t{\n\t\tstd::cout << '0' << '\\n';\n\t\treturn 0;\n\t}\n\twhile (nbr > 0)\n\t{\n\t\tint rem = nbr % 16;\n\t\tchar digit;\n\t\tif (rem < 10)\n\t\t\tdigit = ('0' + rem);\n\t\telse\n\t\t\tdigit = ('A' + (rem - 10));\n\t\tstd::cout << digit;\n\t\tnbr = nbr \/ 16;\n\t}\n\tstd::cout << '\\n';\n\treturn 0;\n}\n"
